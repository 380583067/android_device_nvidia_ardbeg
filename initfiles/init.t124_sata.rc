import init.t124.rc

on post-fs-data
    mount ext4 /dev/block/platform/tegra-sata.0/by-name/FCT /mnt/factory ro

# create filesystems if necessary
service setup_fs /system/bin/setup_fs \
        /dev/block/platform/tegra-sata.0/by-name/UDA \
        /dev/block/platform/tegra-sata.0/by-name/CAC
    class core
    user root
    group root
    oneshot

# Logcat in cache folder while is in bootanimation
service logger /system/bin/logcat -b all -D -f /cache/boot_log.txt
    class main
    user root
    group root system
    disabled
    oneshot

on post-fs-data
    # Clear existing log and start the service
    rm /cache/boot_log.txt
    start logger

on property:sys.boot_completed=1
    # Stop the logger service
    stop logger


